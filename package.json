{
  "name": "digimon-database",
  "version": "0.1.0",
  "private": true,
  "description": "Digimon Database — enciclopédia e explorador de linhas evolutivas de Digimon",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts && npm run db:import && tsx prisma/import-images.ts",
    "setup": "prisma db push && tsx prisma/seed.ts && npm run db:import && tsx prisma/import-images.ts",
    "db:images": "tsx prisma/import-images.ts",
    "preview": "next build && next start -p 3001",
    "db:fetch": "tsx prisma/fetch-digiapi.ts",
    "db:import": "tsx prisma/fetch-digiapi.ts && tsx prisma/import-digiapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.540.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
