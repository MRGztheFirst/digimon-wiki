{
  "name": "digimon-database",
  "version": "0.1.0",
  "private": true,
  "description": "Digimon Database — enciclopédia e explorador de linhas evolutivas de Digimon",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && prisma generate && tsx prisma/seed.ts && npm run db:import && tsx prisma/import-images.ts",
    "setup": "prisma db push && prisma generate && tsx prisma/seed.ts && npm run db:import && tsx prisma/import-images.ts",
    "db:images": "tsx prisma/import-images.ts",
    "preview": "next build && next start -p 3001",
    "db:fetch": "tsx prisma/fetch-digiapi.ts",
    "db:import": "tsx prisma/fetch-digiapi.ts && tsx prisma/import-digiapi.ts && npm run db:wikimon",
    "db:wikimon": "tsx prisma/fetch-wikimon.ts && tsx prisma/import-wikimon.ts"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.79.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
